# AICTE Cyber Security Platform - Production Environment Configuration
# Problem Statement ID: 26106 (AI-Powered Email Threat Detection & Forensic Intelligence)

# Debug Mode (set to false in production)
DEBUG=false

# Database Connection (Async SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///storage/forensic_platform.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://forensic_user:SecurePassword123@localhost:5432/forensic_db

# Cryptographic Vault HMAC Key (REQUIRED in production outside DEBUG; minimum 32 chars)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_HMAC_SECRET=replace_with_64_char_hex_hmac_secret_key

# JWT Authentication Secret Key (REQUIRED in production outside DEBUG)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_cryptographically_secure_jwt_secret

# Security & Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=26214400
RATE_LIMIT_PER_MINUTE=60

# MaxMind GeoIP License Key (For scripts/update_geoip.sh)
MAXMIND_LICENSE_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Initial Administrator Bootstrap (Optional: bootstraps admin account on first start)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@aicte-india.org

